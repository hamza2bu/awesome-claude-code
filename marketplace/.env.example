# ─── Core ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Public base URL, used for payment redirects and onboarding links.
APP_URL="http://localhost:3000"

# ─── Marketplace economics ──────────────────────────────────────────────────
MARKETPLACE_CURRENCY="usd"
# Platform commission in basis points (1000 = 10%). Admins can override per shop.
DEFAULT_COMMISSION_BPS=1000
# Flat shipping per shop in an order (minor units), waived above the threshold.
SHIPPING_PER_SHOP_CENTS=499
FREE_SHIPPING_THRESHOLD_CENTS=5000

# ─── Payments ───────────────────────────────────────────────────────────────
# "stripe" or "local". Defaults to stripe when STRIPE_SECRET_KEY is set; in development it falls back to
# local (a simulated payment page). Production refuses to fall back: set PAYMENT_PROVIDER=local explicitly for demos.
PAYMENT_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Image storage (first configured wins; falls back to ./public/uploads) ──
# Cloudinary: either CLOUDINARY_URL or the three split variables.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# S3 / S3-compatible (R2, MinIO). Credentials come from the standard AWS env/credential chain.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
# Public base URL for objects (e.g. CloudFront). Defaults to the bucket's S3 URL.
S3_PUBLIC_URL=""

# ─── Optional OAuth ─────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
